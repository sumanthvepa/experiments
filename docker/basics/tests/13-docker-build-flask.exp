# scenarios: normal interrupt conflict
# time-limit: 1800
source [file join [file dirname [info script]] tutorial-test.tcl]

# Compare content, type, mode and ownership, including ignored additions.
# Workflow explanation files are intentionally outside the fixture set.
set basics [file dirname $env(TUTORIAL_TEST_TUTORIAL)]
proc fixture_state {} {
  global basics
  return [host_command bash -c {
    set -euo pipefail
    cd "$1"
    find . -maxdepth 1 ! -name '*-improvements.md' -printf '%P %m %u %g %y\n' | sort
    find flask-test -printf '%p %m %u %g %y\n' | sort
    find flask-test -type f -exec sha256sum {} + | sort
    sha256sum 13-docker-build-flask.sh docker-build-flask-test-utilities.sh bash-utilities.sh
  } bash $basics]
}
set fixtures_before [fixture_state]
set base_before ""
if {[host_command_succeeds docker image inspect almalinux:10-minimal]} {
  set base_before [host_command docker image inspect almalinux:10-minimal]
}
set native_arch [host_command docker version --format {{{.Server.Arch}}}]

switch -- [scenario] {
  conflict {
    # Guard every fixture target before any tag/build can overwrite it.
    set fixture "docker-basics-flask-fixture-[pid]"
    foreach tag [list flask-test $fixture] {
      if {[host_command docker image ls --quiet $tag] ne ""} {
        fail "Refusing conflict fixture: image name $tag already exists."
      }
    }
    if {[host_command docker container ls --all --quiet \
        --filter {name=^/flask-test$}] ne ""} {
      fail {Refusing conflict fixture: container flask-test already exists.}
    }
    host_command bash -c {
      set -euo pipefail
      printf 'FROM scratch\nLABEL test.owner="%s"\n' "$1" |
        docker image build --tag "$1" -
    } bash $fixture
    cleanup_on_host docker image rm $fixture
    set image_before [host_command docker image inspect --format \
      { {{.Id}} {{json .Config}} {{json .RootFS}} } $fixture]
    host_command docker image tag $fixture flask-test
    cleanup_on_host docker image rm flask-test
    set tag_before [host_command docker image inspect flask-test]
    start_terminal image-conflict bash -- $env(TUTORIAL_TEST_TUTORIAL)
    wait_for -in image-conflict {Image name flask-test already exists.}
    finish_terminal image-conflict 1
    if {[host_command docker image inspect flask-test] ne $tag_before} {
      fail {conflicting image changed}
    }
    host_command docker image rm flask-test
    cancel_cleanup_on_host
    set id [host_command docker container create --name flask-test \
      $fixture /sentinel]
    cleanup_on_host docker container rm --force $id
    set container_before [host_command docker container inspect $id]
    start_tutorial
    wait_for {Container name flask-test already exists.}
    finish_tutorial 1
    # Full inspect covers identity, config, running state and networks.
    if {[host_command docker container inspect $id] ne $container_before} {
      fail {conflicting container changed}
    }
    host_command docker container rm $id
    cancel_cleanup_on_host
    if {[host_command docker image inspect --format \
        { {{.Id}} {{json .Config}} {{json .RootFS}} } $fixture] ne $image_before} {
      fail {driver fixture image changed}
    }
    host_command docker image rm $fixture
    cancel_cleanup_on_host
  }
  interrupt {
    # Interrupt after the service is ready: container and image must go.
    start_tutorial
    answer_pause -time 900 {Press ENTER to start the Flask container...}
    wait_for {Verified Flask HTTP JSON: {"flask_test":"works"}}
    wait_for {Press ENTER to query the Flask API...}
    press_ctrl_c
    finish_tutorial 130
  }
  normal {
    start_tutorial
    wait_for "Verified native base architecture: $native_arch"
    answer_pause -time 900 {Press ENTER to start the Flask container...}
    wait_for {Verified Flask HTTP JSON: {"flask_test":"works"}}
    # Verify runtime identity, venv, package installation and real response.
    set identity [host_command docker container exec flask-test id -u]
    if {$identity ne "2500"} { fail {Flask did not run as uid 2500} }
    host_command docker container exec flask-test python -c {
import sys, importlib.metadata as m
assert sys.version_info[:2] == (3, 12)
assert sys.prefix == '/opt/flask/production-venv'
assert m.version('Flask') == '3.1.1'
import gunicorn
print(sys.version)
}
    host_command docker container exec flask-test /bin/bash -c {
      set -euo pipefail
      test "$HOME" = /opt/flask
      test -w "$HOME"
      test -x /usr/bin/false
      test "$(getent passwd flask | cut -d: -f7)" = /usr/bin/false
    }
    host_command docker container exec flask-test python -m pip --no-cache-dir check
    set response [host_command curl --noproxy * --fail --silent --show-error \
      --connect-timeout 1 --max-time 2 http://127.0.0.1:5000/]
    if {[host_command bash -c {jq --exit-status ' . == {"flask_test":"works"} ' <<< "$1"} bash $response] ne "true"} { fail {Unexpected Flask HTTP response} }
    set server_log [host_command bash -c {docker container logs flask-test 2>&1}]
    if {[string match {*Control server error:*} $server_log]} {
      fail {Gunicorn control server could not start}
    }
    set mapping [host_command docker container port flask-test 5000/tcp]
    if {$mapping ne "127.0.0.1:5000"} { fail {Flask publish is not loopback only} }
    answer_pause {Press ENTER to query the Flask API...}
    wait_for {The API returned the expected JSON object.}
    answer_pause {Press ENTER to remove the Flask container and image...}
    wait_for {Lesson complete; owned containers and images removed.}
    finish_tutorial 0
  }
}
if {[fixture_state] ne $fixtures_before} {
  fail {tutorial directory, context content, permissions or ownership changed}
}
if {$base_before ne "" &&
    [host_command docker image inspect almalinux:10-minimal] ne $base_before} {
  fail {pre-existing base image changed}
}
send_log "Supplemental fixture and existing-base preservation assertions passed.\n"
