# scenarios: normal interrupt conflict
# time-limit: 2400
source [file join [file dirname [info script]] tutorial-test.tcl]
set basics [file dirname $env(TUTORIAL_TEST_TUTORIAL)]
set native_arch [host_command docker version --format {{{.Server.Arch}}}]
set tag "postgres-test:linux-$native_arch"
set name postgres-save-load-test
proc fixture_state {} {
  global basics
  return [host_command bash -c {
    set -euo pipefail
    cd "$1"
    find . -maxdepth 1 ! -name '*-improvements.md' -printf '%P %m %u %g %y\n' | sort
    find postgres-test -printf '%p %m %u %g %y\n' | sort
    find postgres-test -type f -exec sha256sum {} + | sort
    sha256sum 18-docker-save-load.sh docker-build-postgres-test-utilities.sh bash-utilities.sh
    find /tmp -maxdepth 1       \( -name 'docker-basics-postgres-test.*' -o -name 'docker-basics-save-load.*' \)       -printf '%p %m %u %g %y\n' | sort
  } bash $basics]
}
set fixtures_before [fixture_state]
set base_before ""
if {[host_command_succeeds docker image inspect almalinux:10-minimal]} {
  set base_before [host_command docker image inspect almalinux:10-minimal]
}
proc load_image {identity} {
  global tag
  answer_pause {Press ENTER to remove the saved tag and load the archive...}
  wait_for "Verified saved tag absent: $tag"
  wait_for "After load: $identity"
  set restored [host_command docker image inspect --format {{{.Id}} {{.Os}}/{{.Architecture}} {{json .RepoTags}}} $tag]
  if {$restored ne $identity} { fail {Restored identity/platform/tags changed.} }
}
switch -- [scenario] {
  normal {
    start_tutorial
    wait_for "Verified native base architecture: $native_arch"
    # The image is available only after the initial pause is printed.
    wait_for -time 1200 {Press ENTER to save the native image...}
    set identity [host_command docker image inspect --format {{{.Id}} {{.Os}}/{{.Architecture}} {{json .RepoTags}}} $tag]
    type_line ""
    set archive [lindex [wait_for_regexp {Verified nonempty tar archive: ([^\r\n]+)}] 1]
    # Archive metadata/contents are checked below, while the pause holds it.
    host_command python3 -c {
import json, os, stat, sys, tarfile, hashlib
path, tag, identity, arch = sys.argv[1:]
assert stat.S_IMODE(os.stat(os.path.dirname(path)).st_mode) == 0o700
assert stat.S_IMODE(os.stat(path).st_mode) == 0o600
with tarfile.open(path) as archive:
    manifest = json.load(archive.extractfile('manifest.json'))
    assert len(manifest) == 1 and manifest[0]['RepoTags'] == [tag]
    config_data = archive.extractfile(manifest[0]['Config']).read()
    assert 'sha256:' + hashlib.sha256(config_data).hexdigest() == identity.split()[0]
    config = json.loads(config_data)
    assert config['architecture'] == arch and config['os'] == 'linux'
    assert config['config']['Entrypoint'] == ['docker-entrypoint.sh']
    assert config['config']['Cmd'] == ['postgres']
    assert manifest[0]['Layers']
    for layer in manifest[0]['Layers']:
        assert archive.getmember(layer).size > 0
    } $archive $tag $identity $native_arch
    load_image $identity
    answer_pause {Press ENTER to run PostgreSQL from the restored image...}
    wait_for {Verified restored PostgreSQL TCP query: postgres|postgres|42}
    host_command docker container exec $name /bin/bash -c {
      set -euo pipefail
      test "$(cat /proc/1/comm)" = postgres
      test "$(cat /var/lib/pgsql/16/data/PG_VERSION)" = 16
      test -f /var/lib/pgsql/16/data/.docker-postgres-initialized
    }
    answer_pause {Press ENTER to remove the restored image and archive...}
    wait_for {Lesson complete; restored container, image tag and temporary archive removed.}
    finish_tutorial 0
    if {[file exists [file dirname $archive]]} { fail {Archive directory remains.} }
  }
  interrupt {
    start_tutorial
    wait_for -time 1200 {Press ENTER to save the native image...}
    set identity [host_command docker image inspect --format {{{.Id}} {{.Os}}/{{.Architecture}} {{json .RepoTags}}} $tag]
    type_line ""
    set archive [lindex [wait_for_regexp {Verified nonempty tar archive: ([^\r\n]+)}] 1]
    load_image $identity
    wait_for {Press ENTER to run PostgreSQL from the restored image...}
    press_ctrl_c
    finish_tutorial 130
    if {[file exists [file dirname $archive]]} { fail {Interrupted archive directory remains.} }
  }
  conflict {
    set fixture "docker-basics-save-load-fixture-[pid]"
    foreach image [list $tag $fixture] {
      if {[host_command docker image ls --quiet $image] ne ""} { fail "Fixture image $image already exists." }
    }
    if {[host_command docker container ls --all --quiet --filter "name=^/$name$"] ne ""} {
      fail "Fixture container $name already exists."
    }
    host_command bash -c {
      set -euo pipefail
      printf 'FROM scratch\nLABEL test.owner="%s"\n' "$1" | docker image build --tag "$1" -
    } bash $fixture
    cleanup_on_host docker image rm $fixture
    host_command docker image tag $fixture $tag
    cleanup_on_host docker image rm $tag
    set image_before [host_command docker image inspect $tag]
    start_terminal image-conflict bash -- $env(TUTORIAL_TEST_TUTORIAL)
    wait_for -in image-conflict "Image name $tag already exists."
    finish_terminal image-conflict 1
    if {[host_command docker image inspect $tag] ne $image_before} { fail {Conflicting image changed.} }
    host_command docker image rm $tag
    cancel_cleanup_on_host
    set fixture_before [host_command docker image inspect $fixture]
    set id [host_command docker container create --name $name $fixture /sentinel]
    cleanup_on_host docker container rm --force $id
    set container_before [host_command docker container inspect $id]
    start_tutorial
    wait_for "Container name $name already exists."
    finish_tutorial 1
    if {[host_command docker container inspect $id] ne $container_before} { fail {Conflicting container changed.} }
    host_command docker container rm $id
    cancel_cleanup_on_host
    if {[host_command docker image inspect $fixture] ne $fixture_before} { fail {Fixture image changed.} }
    host_command docker image rm $fixture
    cancel_cleanup_on_host
  }
}
if {[fixture_state] ne $fixtures_before} { fail {Context, files, modes, ownership or temporary inventory changed.} }
if {$base_before ne "" && [host_command docker image inspect almalinux:10-minimal] ne $base_before} {
  fail {Existing base image changed.}
}
send_log "Supplemental context/archive/mode/existing-base assertions passed.\n"
