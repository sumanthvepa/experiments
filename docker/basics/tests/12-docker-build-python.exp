# scenarios: normal interrupt conflict
# time-limit: 1800
source [file join [file dirname [info script]] tutorial-test.tcl]

# Compare content, type, mode and ownership, including ignored additions.
# Workflow explanation files are intentionally outside the fixture set.
set basics [file dirname $env(TUTORIAL_TEST_TUTORIAL)]
proc fixture_state {} {
  global basics
  return [host_command bash -c {
    set -euo pipefail
    cd "$1"
    find . -maxdepth 1 ! -name '*-improvements.md' -printf '%P %m %u %g %y\n' | sort
    find python-test -printf '%p %m %u %g %y\n' | sort
    find python-test -type f -exec sha256sum {} + | sort
    sha256sum 12-docker-build-python.sh bash-utilities.sh
  } bash $basics]
}
set fixtures_before [fixture_state]
set base_before ""
if {[host_command_succeeds docker image inspect almalinux:10-minimal]} {
  set base_before [host_command docker image inspect almalinux:10-minimal]
}

switch -- [scenario] {
  conflict {
    # Guard every fixture target before any tag/build can overwrite it.
    set fixture "docker-basics-python-test-[pid]"
    foreach tag [list python-test $fixture] {
      if {[host_command docker image ls --quiet $tag] ne ""} {
        fail "Refusing conflict fixture: image name $tag already exists."
      }
    }
    if {[host_command docker container ls --all --quiet \
        --filter {name=^/docker-basics-python$}] ne ""} {
      fail {Refusing conflict fixture: container docker-basics-python already exists.}
    }
    host_command bash -c {
      set -euo pipefail
      printf 'FROM scratch\nLABEL test.owner="%s"\n' "$1" |
        docker image build --tag "$1" -
    } bash $fixture
    cleanup_on_host docker image rm $fixture
    set image_before [host_command docker image inspect --format \
      { {{.Id}} {{json .Config}} {{json .RootFS}} } $fixture]
    host_command docker image tag $fixture python-test
    cleanup_on_host docker image rm python-test
    set tag_before [host_command docker image inspect python-test]
    start_terminal image-conflict bash -- $env(TUTORIAL_TEST_TUTORIAL)
    wait_for -in image-conflict {Image names already in use: python-test.}
    finish_terminal image-conflict 1
    if {[host_command docker image inspect python-test] ne $tag_before} {
      fail {conflicting image changed}
    }
    host_command docker image rm python-test
    cancel_cleanup_on_host
    set id [host_command docker container create --name docker-basics-python \
      $fixture /sentinel]
    cleanup_on_host docker container rm --force $id
    set container_before [host_command docker container inspect $id]
    start_tutorial
    wait_for {Container names already in use: docker-basics-python.}
    finish_tutorial 1
    # Full inspect covers identity, config, running state and networks.
    if {[host_command docker container inspect $id] ne $container_before} {
      fail {conflicting container changed}
    }
    host_command docker container rm $id
    cancel_cleanup_on_host
    if {[host_command docker image inspect --format \
        { {{.Id}} {{json .Config}} {{json .RootFS}} } $fixture] ne $image_before} {
      fail {driver fixture image changed}
    }
    host_command docker image rm $fixture
    cancel_cleanup_on_host
  }
  interrupt {
    # Interrupt at a reader pause after the image exists. The runner
    # verifies removal of both it and a newly pulled base.
    start_tutorial
    wait_for -time 900 {Press ENTER to continue...}
    press_ctrl_c
    finish_tutorial 130
  }
  normal {
    start_tutorial
    wait_for {Building python-test for Python 3.14...}
    answer_pause -time 900 {Press ENTER to continue...}
    wait_for {Hello, World!}
    wait_for_regexp {Python 3\.14\.[0-9]+}
    wait_for_regexp {pip [0-9.]+ from [^\r\n]+ \(python 3\.14\)}
    wait_for {Verified Python 3.14 and pip.}
    answer_pause {Press ENTER to continue...}
    # Python 3.14's REPL redraws the coloured input line as it is typed,
    # and writes terminal control sequences before each result. Match
    # each result with its line ending; the typed lines and the hints
    # never contain those strings.
    wait_for {>>> }
    type_line {print("Hello from the REPL!")}
    wait_for "Hello from the REPL!\r\n"
    wait_for {>>> }
    type_line {6 * 7}
    wait_for "42\r\n"
    wait_for {>>> }
    type_line {import sys; print(sys.version_info[:2])}
    wait_for "(3, 14)\r\n"
    wait_for {>>> }
    type_line {quit()}
    answer_pause {Press ENTER to continue...}
    wait_for {Lesson complete; owned containers and images removed.}
    finish_tutorial 0
  }
}
if {[fixture_state] ne $fixtures_before} {
  fail {tutorial directory, context content, permissions or ownership changed}
}
if {$base_before ne "" &&
    [host_command docker image inspect almalinux:10-minimal] ne $base_before} {
  fail {pre-existing base image changed}
}
send_log "Supplemental fixture and existing-base preservation assertions passed.\n"
