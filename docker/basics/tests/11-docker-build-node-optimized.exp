# scenarios: normal interrupt conflict
# time-limit: 1800
source [file join [file dirname [info script]] tutorial-test.tcl]

# Compare content, type, mode and ownership, including ignored additions.
# Workflow explanation files are intentionally outside the fixture set.
set basics [file dirname $env(TUTORIAL_TEST_TUTORIAL)]
proc fixture_state {} {
  global basics
  return [host_command bash -c {
    set -euo pipefail
    cd "$1"
    find . -maxdepth 1 ! -name '*-improvements.md' -printf '%P %m %u %g %y\n' | sort
    find node-test node-test2 -printf '%p %m %u %g %y\n' | sort
    find node-test node-test2 -type f -exec sha256sum {} + | sort
    sha256sum 11-docker-build-node-optimized.sh bash-utilities.sh
  } bash $basics]
}
set fixtures_before [fixture_state]
set base_before ""
if {[host_command_succeeds docker image inspect almalinux:10-minimal]} {
  set base_before [host_command docker image inspect almalinux:10-minimal]
}
set native_arch [host_command docker version --format {{{.Server.Arch}}}]
switch -- [scenario] {
  conflict {
    # Guard every fixture target before any tag/build can overwrite it.
    set fixture "docker-basics-node-optimized-test-[pid]"
    foreach tag [list node-test2 node-test2-repository-baseline $fixture] {
      if {[host_command docker image ls --quiet $tag] ne ""} {
        fail "Refusing conflict fixture: image name $tag already exists."
      }
    }
    if {[host_command docker container ls --all --quiet \
        --filter {name=^/docker-basics-node-optimized$}] ne ""} {
      fail {Refusing conflict fixture: container docker-basics-node-optimized already exists.}
    }
    host_command bash -c {
      set -euo pipefail
      printf 'FROM scratch\nLABEL test.owner="%s"\n' "$1" |
        docker image build --tag "$1" -
    } bash $fixture
    cleanup_on_host docker image rm $fixture
    set image_before [host_command docker image inspect --format \
      { {{.Id}} {{json .Config}} {{json .RootFS}} } $fixture]
    # Exercise both image-name conflicts, comparing full inspect state.
    foreach tag {node-test2 node-test2-repository-baseline} {
      host_command docker image tag $fixture $tag
      cleanup_on_host docker image rm $tag
      set tag_before [host_command docker image inspect $tag]
      start_terminal conflict-$tag bash -- $env(TUTORIAL_TEST_TUTORIAL)
      wait_for -in conflict-$tag "Image names already in use: $tag."
      finish_terminal conflict-$tag 1
      if {[host_command docker image inspect $tag] ne $tag_before} {
        fail "conflicting image $tag changed"
      }
      host_command docker image rm $tag
      cancel_cleanup_on_host
    }
    set id [host_command docker container create --name docker-basics-node-optimized \
      $fixture /sentinel]
    cleanup_on_host docker container rm --force $id
    set container_before [host_command docker container inspect $id]
    start_tutorial
    wait_for {Container names already in use: docker-basics-node-optimized.}
    finish_tutorial 1
    # Full inspect covers identity, config, running state and networks.
    if {[host_command docker container inspect $id] ne $container_before} {
      fail {conflicting container changed}
    }
    host_command docker container rm $id
    cancel_cleanup_on_host
    if {[host_command docker image inspect --format \
        { {{.Id}} {{json .Config}} {{json .RootFS}} } $fixture] ne $image_before} {
      fail {driver fixture image changed}
    }
    host_command docker image rm $fixture
    cancel_cleanup_on_host
  }
  interrupt {
    # Interrupt at a deterministic pause after both images exist.
    start_tutorial
    wait_for -time 900 {Building repository baseline node-test2-repository-baseline.}
    wait_for -time 900 {Press ENTER to continue...}
    press_ctrl_c
    finish_tutorial 130
  }
  normal {
    start_tutorial
    wait_for {Using saved Node.js archive: node-test2/node-v26.13.1-linux-}
    wait_for -time 900 {Building repository baseline node-test2-repository-baseline.}
    answer_pause -time 900 {Press ENTER to continue...}
    set node_arch $native_arch
    if {$native_arch eq "amd64"} {set node_arch x64}
    wait_for "Verified binary runtime: v26.13.1, process.arch=$node_arch"
    wait_for_regexp [format {Verified repository runtime: v26\.[0-9]+\.[0-9]+, process.arch=%s} $node_arch]
    set binary_size [lindex [wait_for_regexp {Measured binary-distribution image: ([0-9]+) bytes.}] 1]
    set repository_size [lindex [wait_for_regexp {Measured repository-install baseline: ([0-9]+) bytes.}] 1]
    set saving [lindex [wait_for_regexp {Repository minus binary distribution: (-?[0-9]+) bytes.}] 1]
    if {$binary_size <= 0 || $repository_size <= 0 || $saving != $repository_size - $binary_size} {
      fail {invalid image-size measurements}
    }
    answer_pause {Press ENTER to continue...}
    wait_for {Removing demonstration image: node-test2-repository-baseline}
    wait_for {Lesson complete; owned containers and images removed.}
    finish_tutorial 0
  }
}
if {[fixture_state] ne $fixtures_before} {
  fail {tutorial directory, build context content, permissions or ownership changed}
}
if {$base_before ne "" &&
    [host_command docker image inspect almalinux:10-minimal] ne $base_before} {
  fail {pre-existing base image changed}
}
send_log "Supplemental fixture and existing-base preservation assertions passed.\n"
