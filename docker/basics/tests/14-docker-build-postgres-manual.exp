# scenarios: normal interrupt conflict
# time-limit: 2400
source [file join [file dirname [info script]] tutorial-test.tcl]
set basics [file dirname $env(TUTORIAL_TEST_TUTORIAL)]
proc fixture_state {} {
  global basics
  return [host_command bash -c {
    set -euo pipefail
    cd "$1"
    find . -maxdepth 1 ! -name '*-improvements.md' -printf '%P %m %u %g %y\n' | sort
    find postgres-manual -printf '%p %m %u %g %y\n' | sort
    find postgres-manual -type f -exec sha256sum {} + | sort
    sha256sum 14-docker-build-postgres-manual.sh bash-utilities.sh
    find /tmp -maxdepth 1 -name 'docker-basics-postgres-manual.*' -printf '%p %m %u %g %y\n' | sort
  } bash $basics]
}
set fixtures_before [fixture_state]
set base_before ""
if {[host_command_succeeds docker image inspect almalinux:10-minimal]} {
  set base_before [host_command docker image inspect almalinux:10-minimal]
}
set native_arch [host_command docker version --format {{{.Server.Arch}}}]
switch -- [scenario] {
  conflict {
    set fixture "docker-basics-postgres-manual-fixture-[pid]"
    foreach tag [list postgres-manual $fixture] {
      if {[host_command docker image ls --quiet $tag] ne ""} { fail "Fixture image $tag already exists." }
    }
    if {[host_command docker container ls --all --quiet --filter {name=^/postgres-manual-test$}] ne ""} {
      fail {Fixture container postgres-manual-test already exists.}
    }
    host_command bash -c {
      set -euo pipefail
      printf 'FROM scratch\nLABEL test.owner="%s"\n' "$1" | docker image build --tag "$1" -
    } bash $fixture
    cleanup_on_host docker image rm $fixture
    host_command docker image tag $fixture postgres-manual
    cleanup_on_host docker image rm postgres-manual
    set image_before [host_command docker image inspect postgres-manual]
    start_terminal image-conflict bash -- $env(TUTORIAL_TEST_TUTORIAL)
    wait_for -in image-conflict {Image name postgres-manual already exists.}
    finish_terminal image-conflict 1
    if {[host_command docker image inspect postgres-manual] ne $image_before} { fail {Conflicting image changed.} }
    host_command docker image rm postgres-manual
    cancel_cleanup_on_host
    # Our intentional tag add/remove updates LastTagTime. Baseline the
    # fixture after those owned changes, before testing container conflict.
    set fixture_before [host_command docker image inspect $fixture]
    set id [host_command docker container create --name postgres-manual-test $fixture /sentinel]
    cleanup_on_host docker container rm --force $id
    set container_before [host_command docker container inspect $id]
    start_tutorial
    wait_for {Container name postgres-manual-test already exists.}
    finish_tutorial 1
    if {[host_command docker container inspect $id] ne $container_before} { fail {Conflicting container changed.} }
    host_command docker container rm $id
    cancel_cleanup_on_host
    if {[host_command docker image inspect $fixture] ne $fixture_before} { fail {Fixture image changed.} }
    host_command docker image rm $fixture
    cancel_cleanup_on_host
  }
  interrupt {
    start_tutorial
    answer_pause -time 1200 {Press ENTER to inspect the uninitialized container shell...}
    wait_for {manual-postgres> }
    type_line {exit 0}
    wait_for {Press ENTER to initialize the database manually...}
    press_ctrl_c
    finish_tutorial 130
  }
  normal {
    start_tutorial
    wait_for "Verified native base architecture: $native_arch"
    answer_pause -time 1200 {Press ENTER to inspect the uninitialized container shell...}
    wait_for {manual-postgres> }
    type_line {postgres --version}
    wait_for_regexp {postgres \(PostgreSQL\) 16\.[0-9]+}
    wait_for {manual-postgres> }
    type_line {printf '%s\n' "${PGDATA:-not set until setup}"}
    wait_for {not set until setup}
    wait_for {manual-postgres> }
    type_line {exit 0}
    answer_pause {Press ENTER to initialize the database manually...}
    wait_for {Database initialization complete; temporary server stopped.}
    wait_for {Manual initialization finished; no server is running.}
    wait_for {Verified manual PostgreSQL TCP query: postgres|postgres|42}
    # An independent client traverses the published host port. It uses
    # --network host on the tested Linux daemon, no host psql installation.
    set id [host_command docker container create --network host \
      --env PGPASSWORD=postgres-demo-only postgres-manual psql \
      --no-psqlrc --set ON_ERROR_STOP=1 --host=127.0.0.1 \
      --username=postgres --dbname=postgres --tuples-only --no-align \
      --command {SELECT current_user, current_database(), 6 * 7;}]
    cleanup_on_host docker container rm --force $id
    set result [host_command docker container start --attach $id]
    if {$result ne "postgres|postgres|42"} { fail "Unexpected independent TCP query: $result" }
    if {[host_command docker container inspect --format {{{.State.ExitCode}}} $id] ne "0"} { fail {Client failed.} }
    host_command docker container rm $id
    cancel_cleanup_on_host
    host_command docker container exec postgres-manual-test /bin/bash -c {
      set -euo pipefail
      test "$(stat -c %U /var/lib/pgsql/16/data)" = postgres
      test "$(stat -c %a /var/lib/pgsql/16/data)" = 700
      test "$(cat /var/lib/pgsql/16/data/PG_VERSION)" = 16
      test -f /var/lib/pgsql/16/data/.docker-postgres-initialized
      test -f /usr/share/zoneinfo/Asia/Kolkata
      rpm -q postgresql16-server tzdata
      gosu --version
    }
    set mapping [host_command docker container port postgres-manual-test 5432/tcp]
    if {$mapping ne "127.0.0.1:5432"} { fail {PostgreSQL publish is not loopback only.} }
    answer_pause {Press ENTER to stop PostgreSQL and remove lesson resources...}
    wait_for {Lesson complete; owned container, images and temporary context removed on exit.}
    finish_tutorial 0
  }
}
if {[fixture_state] ne $fixtures_before} { fail {Repository fixture or temporary state changed.} }
if {$base_before ne "" && [host_command docker image inspect almalinux:10-minimal] ne $base_before} {
  fail {Pre-existing base changed.}
}
send_log "Supplemental context, modes, temporary state and existing-base preservation passed.\n"
